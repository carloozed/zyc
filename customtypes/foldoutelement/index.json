{
  "format": "custom",
  "id": "foldoutelement",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "is_visible": {
        "config": {
          "default_value": true,
          "label": "Is Visible",
          "placeholder_false": "false",
          "placeholder_true": "true"
        },
        "type": "Boolean"
      },
      "belongs_to_foldout": {
        "config": {
          "label": "Belongs to Foldout",
          "placeholder": "Selber Text wie Foldout Name des Parent Foldouts"
        },
        "type": "Text"
      },
      "itemindex": {
        "config": {
          "label": "Itemindex",
          "placeholder": ""
        },
        "type": "Number"
      },
      "foldout_element_topic": {
        "config": {
          "allowTargetBlank": true,
          "label": "Foldout Element Topic",
          "multi": "heading3",
          "placeholder": "Online Anmeldung, Alterskategorie, Auswahlverfahren The Cadenza"
        },
        "type": "StructuredText"
      },
      "content": {
        "config": {
          "fields": {
            "is_hidden": {
              "config": {
                "default_value": false,
                "label": "Is Hidden",
                "placeholder_false": "false",
                "placeholder_true": "true"
              },
              "type": "Boolean"
            },
            "subtopic_title": {
              "config": {
                "allowTargetBlank": true,
                "label": "Subtopic Title",
                "multi": "heading4",
                "placeholder": ""
              },
              "type": "StructuredText"
            },
            "subtopic_description": {
              "config": {
                "allowTargetBlank": true,
                "label": "Subtopic Description",
                "multi": "paragraph,preformatted,strong,em,hyperlink,list-item,o-list-item,rtl",
                "placeholder": ""
              },
              "type": "StructuredText"
            }
          },
          "label": "Content",
          "repeat": true
        },
        "type": "Group"
      }
    }
  },
  "label": "FoldoutElement",
  "repeatable": true,
  "status": true
}
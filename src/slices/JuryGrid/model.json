{
  "id": "jury_grid",
  "type": "SharedSlice",
  "name": "JuryGrid",
  "variations": [
    {
      "id": "base_grid",
      "name": "Base Grid",
      "description": "A grid layout with a headline, introduction, and repeated jury/person entries featuring image, name, description, and optional links.",
      "imageUrl": "https://images.prismic.io/zurichyouthclassical/shared-slices/jury_grid/base_grid/16c12e2db1d41bc7108befb78ea1234fbcf6689e.png?auto=compress%2Cformat",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "headline": {
          "type": "StructuredText",
          "config": {
            "label": "Headline",
            "placeholder": "",
            "single": "heading2",
            "allowTargetBlank": true
          }
        },
        "introduction": {
          "type": "StructuredText",
          "config": {
            "label": "Introduction",
            "multi": "paragraph,strong,em"
          }
        },
        "jurymember_linkicon": {
          "type": "Image",
          "config": {
            "label": "Jurymember Linkicon",
            "constraint": {},
            "thumbnails": []
          }
        },
        "members": {
          "type": "Group",
          "config": {
            "label": "Members",
            "fields": {
              "photo": {
                "type": "Image",
                "config": {
                  "label": "Photo"
                }
              },
              "name": {
                "type": "StructuredText",
                "config": {
                  "label": "Name",
                  "single": "heading3"
                }
              },
              "bio": {
                "type": "StructuredText",
                "config": {
                  "label": "Bio",
                  "multi": "paragraph,strong,em,hyperlink"
                }
              },
              "jurymember_link": {
                "type": "Link",
                "config": {
                  "label": "Jurymember Link",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true,
                  "allowText": true,
                  "repeat": false
                }
              }
            }
          }
        },
        "link_text": {
          "type": "Text",
          "config": {
            "label": "Link Text",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}